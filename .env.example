NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://payments:payments-local@localhost:5432/payments
POSTGRES_PASSWORD=payments-local
# Troque antes de expor a API. Autenticação serviço-a-serviço, não multi-tenant.
API_KEY=change-me-use-a-random-key-of-at-least-32-chars

# PIX funciona sem estas variáveis. Para cartão, preencha TODAS e inicie o worker.
# Use credenciais de vendedor de teste e compradores de teste distintos.
# MP_ACCESS_TOKEN=...
# MP_WEBHOOK_SECRET=...
# MP_COLLECTOR_ID=...
# MP_WEBHOOK_URL=https://seu-dominio/api/webhooks/mercado-pago
# MP_RETURN_URL=https://seu-frontend/resultado
MP_SANDBOX=true
MP_TIMEOUT_MS=8000
WEBHOOK_TOLERANCE_SECONDS=300
WORKER_POLL_MS=1000
